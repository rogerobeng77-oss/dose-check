  "target": {
    "id": "nightscout",
    "name": "nightscout/cgm-remote-monitor (Bolus Wizard Preview)",
    "repo": "https://github.com/nightscout/cgm-remote-monitor",
    "commit": "92d0834",
    "licence": "AGPL-3.0",
    "stars": 2835,
    "language": "JavaScript (Node)",
    "unit_file": "lib/plugins/boluswizardpreview.js",
    "run_mode": "The real boluswizardpreview.js is required and its real bwp.calc(sbx) runs against a faithful sandbox object; only lib/times is shimmed.",
    "claimed_formula": "effect = IOB*sens ; outcome = BG - effect ; if outcome > target_high: bolus = (outcome - target_high)/sens   (IOB IS subtracted; refuses on missing info)"
  },
  "reference": {
    "formula": "bolus = CHO/ICR + (G - G_target)/ISF - IOB",
    "cite": "Zhu et al., Sensors 2020, Eq. 4 (PMC7570884, CC BY 4.0)"
  },
  "contract": {
    "dose_function": [
      "calc"
    ],
    "inputs": [
      {
        "name": "IOB",
        "unit": "U",
        "where_parsed": "sbx.properties.iob.iob"
      },
      {
        "name": "Scaled SGV (G)",
        "unit": "mg/dL",
        "where_parsed": "sbx.lastScaledSGV()"
      },
      {
        "name": "High BG Target",
        "unit": "mg/dL",
        "where_parsed": "profile.getHighBGTarget(sbx.time)"
      },
      {
        "name": "Low BG Target",
        "unit": "mg/dL",
        "where_parsed": "profile.getLowBGTarget(sbx.time)"
      },
      {
        "name": "Sensitivity (ISF)",
        "unit": "mg/dL/U",
        "where_parsed": "profile.getSensitivity(sbx.time)"
      }
    ],
    "implemented_formula": "bolusEstimate = (scaledSGV - iob*ISF - target) / ISF",
    "suspected_deviations": [
      {
        "claim": "Missing carbohydrate term (CHO/ICR) from reference formula",
        "line_hint": "bolusEstimate = delta / sens",
        "why_it_matters": "Ignores meal carbs, may under\u2011dose when food is present"
      },
      {
        "claim": "No protection against zero or negative sensitivity (ISF)",
        "line_hint": "delta / sens",
        "why_it_matters": "Division by zero or negative ISF would produce invalid or unsafe bolus"
      },
      {
        "claim": "No upper dose ceiling or safety limit on bolusEstimate",
        "line_hint": "results.bolusEstimate = delta / sens",
        "why_it_matters": "Could recommend excessively large bolus if inputs are extreme"
      },
      {
        "claim": "Negative bolus values are allowed without clarification",
        "line_hint": "results.bolusEstimate = delta / sens * -1",
        "why_it_matters": "Negative bolus displayed as insulin reduction may be confusing to users"
      },
      {
        "claim": "IOB is taken directly from sbx.properties.iob.iob without validation of missing or stale data",
        "line_hint": "var iob = results.iob = sbx.properties.iob.iob || 0;",
        "why_it_matters": "Stale IOB could lead to incorrect insulin on board correction"
      }
    ]
  },
